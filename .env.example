# For server
# Slack: create an app at https://api.slack.com/apps -> OAuth & Permissions -> Bot Token Scopes
# (chat:write, channels:read, per src/components/slack/app.ts) -> add Redirect URL
# {BASE_URL}/oauth/callback/slack -> Client ID/Secret are under Basic Information.
#
# Hit "Demo App doesn't have a bot user to install"? Fix:
#   1. Go to your Slack app at api.slack.com/apps -> OAuth & Permissions.
#   2. Under Bot Token Scopes, add all 13: chat:write, chat:write.public, im:write, channels:read,
#      channels:manage, channels:join, reactions:write, reactions:read, users:read, users:read.email,
#      files:write, files:read, channels:history.
#   3. Under User Token Scopes (separate section, same page), add both: chat:write, search:read.
#   4. Click Save Changes.
#   5. Retry the connect flow (POST /connections { "app": "slack", ... } -> open the returned connect_url).
#
# Hit "Slack post_message failed: not_in_channel"? The bot isn't a member of that channel yet. Either
# /invite it into that specific channel from within Slack, or (durable fix, covers every public channel)
# make sure chat:write.public is in your app's Bot Token Scopes per step 2 above, then reconnect — a scope
# change needs a fresh OAuth grant, re-running POST /connections doesn't pick it up on its own. Private
# channels still need an explicit /invite regardless of this scope.
#
# Subscribed a trigger (new_message etc.) and it just never fires, no error anywhere? chat:write.public
# above ONLY covers posting to a channel without joining — it does nothing for RECEIVING events. Slack's
# Events API still requires the bot to actually be a MEMBER of a channel before it'll deliver
# message.channels/reaction_added/etc. events from it. Check with GET_CHANNEL_DETAILS's `is_member` field,
# and fix with the join_channel action (SLACK_JOIN_CHANNEL) — needs the channels:join scope above.
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...

# Slack Events API (real-time triggers — see src/components/slack/triggers/*.ts):
#   1. Go to your Slack app -> Event Subscriptions -> Enable Events.
#   2. Request URL: {BASE_URL}/webhooks/slack/events (Slack verifies this with a one-time challenge, our
#      server handles it automatically — see the "Your URL didn't respond" note further below if it fails).
#   3. Under "Subscribe to bot events", add all 9:
#        message.channels   -> new_message / message_edited / message_deleted in PUBLIC channels
#        message.groups     -> same 3 triggers, in PRIVATE channels
#        message.im         -> same 3 triggers, in 1:1 DMs
#        message.mpim       -> same 3 triggers, in group DMs
#        reaction_added     -> reaction_added trigger
#        reaction_removed   -> reaction_removed trigger
#        member_joined_channel -> user_joined_channel trigger
#        channel_created    -> channel_created trigger
#        file_shared        -> file_shared trigger
#      (message_edited/message_deleted are subtypes of the same `message.*` events above — no separate
#      subscription needed for them.)
#   4. Click Save.
# Signing Secret is under Basic Information -> App Credentials -> Signing Secret (NOT the OAuth Client
# Secret above — different value, same page).
#
# IMPORTANT for local dev: Slack must be able to reach the Request URL from the internet, so
# BASE_URL=http://localhost:3005 (the default below) will NOT work here — Slack's URL-verification
# handshake will fail with a timeout. Point BASE_URL at a public tunnel instead (e.g.
# `devtunnel host -p 3005`, or `devtunnel port create <tunnel-id> -p 3005 --protocol http` if a tunnel is
# already running) and set BASE_URL to that tunnel's https URL, e.g.
# BASE_URL=https://gnq2twjw-3005.inc1.devtunnels.ms — Google/Gmail's OAuth redirect (below) also needs to
# match whatever BASE_URL you use, since {BASE_URL}/oauth/callback/gmail is registered there too. Gmail's
# own triggers (new_email etc.) are POLL-mode, not webhooks — they need no public URL and no Google-side
# push/Pub-Sub setup at all, only `bun run worker` running.
SLACK_SIGNING_SECRET=...

# Gmail: create an OAuth client at https://console.cloud.google.com/apis/credentials (type: Web
# application) -> Authorized redirect URI {BASE_URL}/oauth/callback/gmail -> enable the Gmail API for
# the project first (APIs & Services -> Library).
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...

# Default poll cadence for every Gmail trigger (new_email, new_draft, new_sent_email, new_labeled_email,
# new_starred_email) — only the DEFAULT a new subscription gets when its own POST
# /triggers/gmail/:trigger/subscribe body doesn't pass `poll_interval_ms` (that per-subscription override
# already exists and still wins when given). 60s minimum, same floor trigger_routes.ts enforces at
# subscribe time either way. Lower this for faster local testing, e.g. 2 min instead of waiting 8:
# GMAIL_POLL_INTERVAL_MS=120000
GMAIL_POLL_INTERVAL_MS=480000

# Port Bun.serve() actually binds to (src/server.ts).
PORT=3005

# Used to build each app's redirect_uri ({BASE_URL}/oauth/callback/:app, see src/lib/oauth.ts) and the
# connect_url handed back from POST /connections (see src/api/connection_routes.ts). Verified working
# end-to-end against real Google/Slack endpoints with this exact shape — not an open question anymore.
# Keep the port here in sync with PORT above for local dev (they're separate values — see src/config.ts —
# but should match unless something's proxying in front of this server).
BASE_URL=http://localhost:3005

# No SERPAPI_* client credentials here on purpose — SerpApi (src/components/serpapi/) is an api_key-type
# app: the caller supplies their own key directly in POST /connections { secrets: { api_key } } at connect
# time, per spec, not a shared platform-level key. (SERPER_API_KEY below is unrelated — a different
# service, pre-existing in this file, not wired to any App yet.)
SERPER_API_KEY=

# REQUIRED for any App to actually work — every Connection.secrets (OAuth tokens, SerpApi keys, etc.) is
# encrypted at rest with this key (AES-256-GCM, see src/lib/cipher.ts) before it ever touches storage.
# Generate with: openssl rand -base64 32
# There is deliberately no fallback/default — a missing key throws instead of silently encrypting with a
# weak one. Losing this key makes every stored secret unrecoverable — back it up like you would a DB password.
ENCRYPTION_KEY=

# Bearer token gating the whole REST API (and the OpenAPI/Swagger docs at /docs, /openapi.json) — so only
# our own server/client calls this, not for public use for now, same as MCP is gated. Every gated route
# accepts `Authorization: Bearer <ACCESS_TOKEN>` — no query-param fallback. /docs itself is gated via a
# one-time login form (POST /docs/login) backed by an HttpOnly session cookie, not a header, since a plain
# browser navigation can't set one — see src/api/docs_routes.ts. Also doubles as the MCP login form's
# access_key (/mcp/login). NOT gated: /webhooks/*, /oauth/callback/{app} (external providers call these
# directly), /connect/{token} (single-use token IS its own auth). Generate with `openssl rand -hex 32`.
ACCESS_TOKEN=

# Same shape, additionally required on /admin/* (ACCESS_TOKEN alone is refused there). Also valid anywhere
# ACCESS_TOKEN is. Generate with `openssl rand -hex 32`.
ADMIN_ACCESS_TOKEN=

# Internal — S3 client (src/lib/s3.ts) exists but is still unused by anything. Postgres (src/lib/postgres.ts)
# and Redis (src/lib/redis.ts) ARE genuinely wired in now — see DATABASE_URL/REDIS_URL below.
STORAGE_DEFAULT=s3
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_BUCKET=...
AWS_REGION=ap-south-1

# REQUIRED now — no longer just Phase 4 scaffolding. Every POST /connections for an oauth2/api_key app
# creates a Redis-backed connect token (src/lib/redis.ts) — without a reachable Redis, connecting ANY
# app fails, not just triggers/locking. Read by Bun.redis automatically — VALKEY_URL takes precedence if
# both are set. If unset, Bun.redis falls back to valkey://localhost:6379 on its own — set this explicitly
# to be sure you know which Redis you're pointed at.
REDIS_URL=redis://localhost:6379

# Read by Bun.sql (src/lib/postgres.ts) automatically. Also read directly by drizzle-kit (drizzle.config.ts)
# for `bun run db:generate`/`db:migrate` — see MIGRATIONS.md.
DATABASE_URL=postgres://localhost:5432/tool_provider
