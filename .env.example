# For server
# Slack: create an app at https://api.slack.com/apps -> OAuth & Permissions -> Bot Token Scopes
# (chat:write, channels:read, per src/components/slack/app.ts) -> add Redirect URL
# {BASE_URL}/oauth/callback/slack -> Client ID/Secret are under Basic Information.
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...

# Slack Events API (real-time triggers, e.g. new_message) — same app as above, different config section:
# Event Subscriptions -> Enable Events -> Request URL = {BASE_URL}/webhooks/slack/events (Slack verifies
# this URL with a one-time challenge, our server handles it automatically) -> Subscribe to bot events ->
# add `message.channels` (and `message.im` for DMs) -> Save. Signing Secret is under Basic Information ->
# App Credentials -> Signing Secret (NOT the OAuth Client Secret above — different value, same page).
SLACK_SIGNING_SECRET=...

# Gmail: create an OAuth client at https://console.cloud.google.com/apis/credentials (type: Web
# application) -> Authorized redirect URI {BASE_URL}/oauth/callback/gmail -> enable the Gmail API for
# the project first (APIs & Services -> Library).
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...

# Port Bun.serve() actually binds to (src/server.ts).
PORT=3005

# Used to build each app's redirect_uri ({BASE_URL}/oauth/callback/:app, see src/lib/oauth.ts) and the
# connect_url handed back from POST /connections (see src/api/connection_routes.ts). Verified working
# end-to-end against real Google/Slack endpoints with this exact shape — not an open question anymore.
# Keep the port here in sync with PORT above for local dev (they're separate values — see src/config.ts —
# but should match unless something's proxying in front of this server).
BASE_URL=http://localhost:3005

# No SERPAPI_* client credentials here on purpose — SerpApi (src/components/serpapi/) is an api_key-type
# app: the caller supplies their own key directly in POST /connections { secrets: { api_key } } at connect
# time, per spec, not a shared platform-level key. (SERPER_API_KEY below is unrelated — a different
# service, pre-existing in this file, not wired to any App yet.)
SERPER_API_KEY=

# REQUIRED for any App to actually work — every Connection.secrets (OAuth tokens, SerpApi keys, etc.) is
# encrypted at rest with this key (AES-256-GCM, see src/lib/cipher.ts) before it ever touches storage.
# Generate with: openssl rand -base64 32
# There is deliberately no fallback/default — a missing key throws instead of silently encrypting with a
# weak one. Losing this key makes every stored secret unrecoverable — back it up like you would a DB password.
ENCRYPTION_KEY=

# Bearer token gating the whole REST API (and the OpenAPI/Swagger docs at /docs, /openapi.json) — so only
# our own server/client calls this, not for public use for now, same as MCP is gated. Every gated route
# accepts `Authorization: Bearer <ACCESS_TOKEN>` — no query-param fallback. /docs itself is gated via a
# one-time login form (POST /docs/login) backed by an HttpOnly session cookie, not a header, since a plain
# browser navigation can't set one — see src/api/docs_routes.ts. Also doubles as the MCP login form's
# access_key (/mcp/login). NOT gated: /webhooks/*, /oauth/callback/{app} (external providers call these
# directly), /connect/{token} (single-use token IS its own auth). Generate with `openssl rand -hex 32`.
ACCESS_TOKEN=

# Same shape, additionally required on /admin/* (ACCESS_TOKEN alone is refused there). Also valid anywhere
# ACCESS_TOKEN is. Generate with `openssl rand -hex 32`.
ADMIN_ACCESS_TOKEN=

# Internal — S3 client (src/lib/s3.ts) exists but is still unused by anything. Postgres (src/lib/postgres.ts)
# and Redis (src/lib/redis.ts) ARE genuinely wired in now — see DATABASE_URL/REDIS_URL below.
STORAGE_DEFAULT=s3
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_BUCKET=...
AWS_REGION=ap-south-1

# REQUIRED now — no longer just Phase 4 scaffolding. Every POST /connections for an oauth2/api_key app
# creates a Redis-backed connect token (src/lib/redis.ts) — without a reachable Redis, connecting ANY
# app fails, not just triggers/locking. Read by Bun.redis automatically — VALKEY_URL takes precedence if
# both are set. If unset, Bun.redis falls back to valkey://localhost:6379 on its own — set this explicitly
# to be sure you know which Redis you're pointed at.
REDIS_URL=redis://localhost:6379

# Read by Bun.sql (src/lib/postgres.ts) automatically. Also read directly by drizzle-kit (drizzle.config.ts)
# for `bun run db:generate`/`db:migrate` — see MIGRATIONS.md.
DATABASE_URL=postgres://localhost:5432/tool_provider
