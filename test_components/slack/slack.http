### test_components/slack/slack.http — full manual test flow for the Slack component: connect, every
### action (15), the trigger (subscribe/unsubscribe + the webhook endpoint itself). Same JetBrains HTTP
### Client / VS Code REST Client format as the root ../../tool_provider.http (which now only keeps a
### couple of Slack examples for a quick smoke test — this file is the complete one). Unit tests covering
### the same actions against mocked responses live in ./actions/*.test.ts (`bun test test_components/slack`).
###
### Slack's new_message trigger needs no worker — it's delivered by the API server itself via
### POST {{base_url}}/webhooks/slack/events, registered as the Request URL in Slack's own app config
### (Events API). No polling, unlike Gmail.

@base_url = https://gnq2twjw-3005.inc1.devtunnels.ms

### Paste your real values from .env here (ACCESS_TOKEN / ADMIN_ACCESS_TOKEN) — every gated route now
### requires a real 'Authorization: Bearer <token>' header, no ?token= query-param fallback anymore.
@access_token = 3772288b374e7045c59364c8dcad4be12dc1338cf0a80d6dee42ac2adaa392d1
@admin_access_token = REPLACE_ME_ADMIN_ACCESS_TOKEN

### ----------------------------------------------------
### 🔧 Create a user (skip if you already have one — see root tool_provider.http)
### ----------------------------------------------------
POST {{base_url}}/users
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "metadata": { "note": "created from test_components/slack/slack.http" }
}

### Copy the returned user_id into this variable
@user_id = usr_b9bb4865-f3c9-48cd-b8f0-2c62e2935245

### ----------------------------------------------------
### 🔧 Connect Slack (oauth2) — copy the returned connect_url and open it in a browser to finish OAuth.
### Requests both bot scopes (`scope`) and user scopes (`user_scope: chat:write,search:read` — needed for
### as_user:true and find_messages, see app.ts's extraAuthorizeParams comment).
### ----------------------------------------------------
POST {{base_url}}/connections
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "user_id": "{{user_id}}",
  "app": "slack",
  "extra_metadata": {
      "note": "created from tool_provider.http"
    }
}

### Copy the returned connection_id here once the OAuth flow above completes
@slack_connection_id = conn_2d3e8925-7480-48d8-be36-64ebad2ead0f

### ----------------------------------------------------
### 🔧 Check the connection's status — should be "active" once OAuth completes
### ----------------------------------------------------
GET {{base_url}}/connections/{{slack_connection_id}}
Authorization: Bearer {{access_token}}

### ----------------------------------------------------
### 🔧 Check all connections — every Slack connection this user has (not just the one above; useful if
### you've reconnected more than once, e.g. after a revoke/expire). Optional &app=slack narrows to just
### this app (omit it to see every app this user has connected, Gmail/SerpApi included).
### ----------------------------------------------------
GET {{base_url}}/connections?user_id={{user_id}}&app=slack
Authorization: Bearer {{access_token}}

### ----------------------------------------------------
### 🔧 Remove a connection — real revoke, not cosmetic: flips status -> "revoked" and clears `secrets`
### (the stored access_token/user_access_token are gone, not just hidden). `user_id` query param required
### and checked against the connection's own owner (404, not 403, on a mismatch — doesn't reveal whether
### the connection_id exists at all to a non-owner). Doesn't delete the row itself — action_logs/
### trigger_instances still FK to it, so history stays intact. To reconnect after this, just run the
### connect flow again from the top of this file (POST /connections { "app": "slack", ... }).
### ----------------------------------------------------
DELETE {{base_url}}/connections/{{slack_connection_id}}?user_id={{user_id}}
Authorization: Bearer {{access_token}}

# ============================================================================
# ACTIONS (15)
# ============================================================================

### ----------------------------------------------------
### 🔧 post_message — post to a channel (as_user:false = bot token, default)
### ----------------------------------------------------
POST {{base_url}}/actions/execute/SLACK_POST_MESSAGE
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "connection_id": "{{slack_connection_id}}",
  "input": { "channel": "#test-user", "text": "Hello from slack.http" }
}

### Copy a channel + ts here to test update/delete/reactions below — the ID FROM POST_MESSAGE'S RESPONSE,
### not the "#name" you passed as input above. chat.postMessage (post_message) tolerates and resolves a
### "#channel-name"; chat.update/chat.delete/reactions.add/reactions.remove (everything below) do NOT do
### that resolution and reject a name with channel_not_found — they need the real channel ID (e.g.
### "C0772SYKNN4" for #test-user).
@slack_channel = C0772SYKNN4
@slack_message_ts = 1789028689.945889

### ----------------------------------------------------
### 🔧 post_message — as_user:true (posts using the authorizing human's own token, not the bot)
### ----------------------------------------------------
POST {{base_url}}/actions/execute/SLACK_POST_MESSAGE
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "connection_id": "{{slack_connection_id}}",
  "input": { "channel": "{{slack_channel}}", "text": "Posted as the connected user", "as_user": true }
}

### ----------------------------------------------------
### 🔧 update_message — edit a previously posted message (as_user must match how it was originally sent).
### `channel_id` — chat.update requires the real ID, unlike post_message's `channel` above (which accepts
### and resolves a "#name"); passing a name here fails with channel_not_found.
### ----------------------------------------------------
POST {{base_url}}/actions/execute/SLACK_UPDATE_MESSAGE
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "connection_id": "{{slack_connection_id}}",
  "input": { "channel_id": "{{slack_channel}}", "ts": "{{slack_message_ts}}", "text": "Edited via slack.http 2" }
}

### ----------------------------------------------------
### 🔧 delete_message — delete a message (as_user must match how it was originally sent). `channel_id`,
### same "real ID required, no #name" rule as update_message above.
### ----------------------------------------------------
POST {{base_url}}/actions/execute/SLACK_DELETE_MESSAGE
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "connection_id": "{{slack_connection_id}}",
  "input": { "channel_id": "{{slack_channel}}", "ts": "{{slack_message_ts}}" }
}

