POST {{base_url}}/actions/execute/SLACK_ADD_REACTION
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "connection_id": "{{slack_connection_id}}",
  "input": { "channel_id": "{{slack_channel}}", "ts": "{{slack_message_ts}}", "name": "thumbsup" }
}

### ----------------------------------------------------
### 🔧 remove_reaction — remove an emoji reaction. `channel_id`, same "real ID required" rule.
### ----------------------------------------------------
POST {{base_url}}/actions/execute/SLACK_REMOVE_REACTION
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "connection_id": "{{slack_connection_id}}",
  "input": { "channel_id": "{{slack_channel}}", "ts": "{{slack_message_ts}}", "name": "thumbsup" }
}

