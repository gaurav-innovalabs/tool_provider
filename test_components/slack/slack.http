### 🔧 find_messages — search (requires the user token / search:read — see app.ts's extraAuthorizeParams)
### ----------------------------------------------------
POST {{base_url}}/actions/execute/SLACK_FIND_MESSAGES
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "connection_id": "{{slack_connection_id}}",
  "input": { "query": "Hello from", "sort": "timestamp", "count": 20 }
}

# ============================================================================
# TRIGGERS (8) — all webhook mode, no polling, all delivered off the ONE Events API subscription URL
# ({{base_url}}/webhooks/slack/events — Slack app config -> Event Subscriptions -> Request URL). GET
# {{base_url}}/triggers lists all 8 live from the registry: new_message, message_edited, message_deleted,
# reaction_added, reaction_removed, user_joined_channel, channel_created, file_shared. See
# src/components/slack/app.ts's `webhooks` block for the full request-flow write-up (generic
# /webhooks/:app/:hook dispatcher -> app.webhooks[hook] -> src/components/slack/webhooks/events.ts).
# ============================================================================

### ----------------------------------------------------
### 🔧 List available Slack triggers — each entry's `config` field is the JSON Schema of the per-instance
### input props that trigger accepts below (null for channel_created, which has nothing to scope by).
### ----------------------------------------------------
GET {{base_url}}/triggers
Authorization: Bearer {{access_token}}

### ----------------------------------------------------
### 🔧 Subscribe — new_message, UNSCOPED (fires for every message in every channel the app can see).
### webhook_url below is where WE deliver parsed events to; separately, Slack's own Events API must be
### configured (in Slack's app config) to POST to {{base_url}}/webhooks/slack/events for events to arrive
### here in the first place — see .env.example's SLACK_SIGNING_SECRET comment for the exact click-path +
### which bot events to subscribe to.
### ----------------------------------------------------
POST {{base_url}}/triggers/slack/new_message/subscribe
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "connection_id": "{{slack_connection_id}}",
  "webhook_url": "https://webhook.site/32a6c8e9-bf53-4968-9f47-1c063946d47d",
  "extra_metadata": { "notes": "for the #support-eu channel" }
}

### Copy the returned trigger_instance_id to unsubscribe below
@slack_new_message_ti = ti_c0af1c02-8f03-4ef6-9af8-da6114a476ec

### ----------------------------------------------------
### 🔧 Check MY trigger subscriptions — every instance this user has, across every app (not just Slack) —
### distinct from GET /triggers above (available trigger TYPES, not what's actually subscribed). Client-
### facing (checked against the caller's own user_id, not admin-only) — GET /admin/triggers further below
### is the separate "every instance, every user" view. Optional &app=slack narrows to just this app.
### ----------------------------------------------------
GET {{base_url}}/triggers/instances?user_id={{user_id}}&app=slack
Authorization: Bearer {{access_token}}

### ----------------------------------------------------
### 🔧 Check MY most recent trigger fires — across EVERY trigger I've subscribed to, not just one
### trigger_instance_id (that's the per-instance logs example right below this one). Each row carries its
### own trigger_instance_id/app/trigger_key so you can tell which subscription it came from. Same
### with_payload=true/limit=20 defaults as the per-instance version. Optional &app=slack narrows to one app.
### ----------------------------------------------------
GET {{base_url}}/triggers/logs?user_id={{user_id}}
Authorization: Bearer {{access_token}}

###
GET {{base_url}}/triggers/logs?user_id={{user_id}}&app=slack&with_payload=false&limit=5
Authorization: Bearer {{access_token}}

### ----------------------------------------------------
### 🔧 Check ONE instance's delivery/poll logs — Stripe-CLI-`events list`-style history: every attempt to
### fire this specific subscription (webhook-mode Slack triggers only ever have delivery attempts, no poll
### attempts — those are Gmail-only, see test_components/gmail/gmail.http). `status` per row is success or
### error; `resendable` says whether POST /triggers/logs/{log_id}/resend will work on it (only delivery
### rows with a captured payload are resendable, not poll-attempt rows). Empty `logs` here just means this
### instance hasn't fired yet — post a real message/reaction/etc. in Slack to make it fire, then re-check.
###
### Defaults: `with_payload=true` (the exact envelope delivered — {id, type, metadata, data, timestamp} —
### is inlined on every delivery row, no second GET /triggers/logs/{log_id} call needed per row) and
### `limit=20`. Both are plain query params, pass them on the fly, no other endpoint needed:
### ----------------------------------------------------
GET {{base_url}}/triggers/instances/{{slack_new_message_ti}}/logs?user_id={{user_id}}
Authorization: Bearer {{access_token}}

### Same call, but skip the (sometimes large) payload bodies — just status/error/webhook_url per row
GET {{base_url}}/triggers/instances/{{slack_new_message_ti}}/logs?user_id={{user_id}}&with_payload=false&limit=5
Authorization: Bearer {{access_token}}

### ----------------------------------------------------
### 🔧 Unsubscribe — new_message. Real delete (not a soft-revoke like connections) — run the two checks
### above BEFORE this if you still want to inspect this instance.
### ----------------------------------------------------
DELETE {{base_url}}/triggers/{{slack_new_message_ti}}
Authorization: Bearer {{access_token}}

### ----------------------------------------------------
### 🔧 Subscribe — new_message, SCOPED TO ONE CHANNEL (#test-user, C0772SYKNN4). `config.channel_id` is this
### trigger's per-instance INPUT PROPS (same concept as Composio's trigger_config / Pipedream's
### per-source configurable props — see types.ts's TriggerDefinition.config) — every other subscription to
### this same trigger key is unaffected; each trigger_instance_id has its own independent config.
### ----------------------------------------------------
POST {{base_url}}/triggers/slack/new_message/subscribe
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "connection_id": "{{slack_connection_id}}",
  "webhook_url": "https://webhook.site/32a6c8e9-bf53-4968-9f47-1c063946d47d",
  "config": { "channel_id": "{{slack_channel}}" },
  "extra_metadata": { "notes": "for the #support-eu channel" }
}

### Copy the returned trigger_instance_id to unsubscribe below
@slack_new_message_channel_ti = ti_a49df946-dfbf-47f8-b524-8f75d71d9436

###
GET {{base_url}}/triggers/instances/{{slack_new_message_channel_ti}}/logs?user_id={{user_id}}
Authorization: Bearer {{access_token}}

###
DELETE {{base_url}}/triggers/{{slack_new_message_channel_ti}}
Authorization: Bearer {{access_token}}

### ----------------------------------------------------
### 🔧 Subscribe — new_message, SCOPED TO ONE THREAD. `config.thread_ts` is the parent message's own `ts`
### (get one from GET_CHANNEL_HISTORY/find_messages, or the `ts` a prior new_message event delivered) —
### pass both `channel` and `thread_ts` together to scope to one thread within one channel; only replies
### within that exact thread fire. Same shape applies to message_edited/message_deleted below.
### ----------------------------------------------------
POST {{base_url}}/triggers/slack/new_message/subscribe
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "connection_id": "{{slack_connection_id}}",
  "webhook_url": "https://webhook.site/your-unique-url-here",
  "config": { "channel_id": "{{slack_channel}}", "thread_ts": "1234567890.123456" },
  "extra_metadata": { "notes": "for the #support-eu channel" }
}

### Copy the returned trigger_instance_id to unsubscribe below
@slack_new_message_thread_ti = ti_REPLACE_ME

###
DELETE {{base_url}}/triggers/{{slack_new_message_thread_ti}}
Authorization: Bearer {{access_token}}

